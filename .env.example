APP_NAME="Atención Ciudadana"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/atencion-ciudadana

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atencion_ciudadana
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Cookie de sesión propia: evita choques con otras apps Laravel en el mismo dominio (localhost).
SESSION_COOKIE=atencion_ciudadana_session
