{
    "name": "atencion-ciudadana/atencion-ciudadana",
    "type": "project",
    "description": "Atención Ciudadana: el vecino reporta un problema de su comunidad y el personal lo atiende desde una bandeja con 3 estados.",
    "keywords": [
        "laravel",
        "atencion-ciudadana",
        "reportes"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "jeroennoten/laravel-adminlte": "^3.15",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/dusk"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
