{
    "name": "atencion-ciudadana/atencion-ciudadana",
    "type": "project",
    "description": "Atención Ciudadana: el vecino reporta un problema de su comunidad y el personal lo atiende desde una bandeja con 3 estados.",
    "keywords": [
        "laravel",
        "atencion-ciudadana",
        "reportes"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "fruitcake/php-cors": "^1.3",
        "guzzlehttp/guzzle": "^7.8",
        "jeroennoten/laravel-adminlte": "^3.15",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.6",
        "league/mime-type-detection": "^1.9",
        "maatwebsite/excel": "*",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-permission": "^6.0",
        "symfony/console": "^7.0",
        "twbs/bootstrap-icons": "^1.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/dusk",
                "spatie/laravel-permission",
                "barryvdh/laravel-dompdf",
                "simplesoftwareio/simple-qrcode",
                "maatwebsite/excel",
                "laravel/sanctum",
                "laravel/ui"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
